# Install as /etc/portfolio/portfolio.env, owned by the deploy user, mode 600.
# Read by Node at start (PM2's --env-file) and by deploy.sh for SITE_URL at
# build time. Never commit the real file.

# Public address, no trailing slash. Baked into prerendered pages at build
# time and needed again when pages refresh daily.
SITE_URL=https://salimelhani.tn

RESEND_API_KEY=
# Optional: where notifications are delivered. Defaults to the public contact
# address in content/profile.ts.
CONTACT_TO_EMAIL=
# Optional: overrides the default sender, "Portfolio <contact@mail.salimelhani.tn>"
# (the mail.salimelhani.tn domain is verified in Resend). In Resend's sandbox
# mode, use onboarding@resend.dev — and note sandbox only delivers to the
# address the Resend account is signed up with.
CONTACT_FROM_EMAIL=
