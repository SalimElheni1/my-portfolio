# Copy this file to .env.local (which is gitignored) and fill in real values.
# .env.local is never committed — it's how secrets stay out of the repo.

# Get a free API key at https://resend.com (free tier: 3,000 emails/month).
RESEND_API_KEY=

# Where contact-form notifications are delivered. Defaults to the public
# contact address in content/profile.ts; set this to send them elsewhere.
CONTACT_TO_EMAIL=

# The Resend sender. Defaults to "Portfolio <contact@mail.salimelhani.tn>",
# whose domain is verified in Resend. While the domain is unverified, Resend
# only accepts onboarding@resend.dev as the sender and only delivers to the
# account's own address.
CONTACT_FROM_EMAIL=

# The site's public address, with no trailing slash (e.g. https://salimelhani.tn).
# Used for canonical links, the sitemap, robots.txt, and social previews.
# Pages are refreshed once a day while the site runs, so set it for the
# running server too, not only the build. A production build refuses to run
# without it; local dev falls back to http://localhost:3000.
SITE_URL=

# Development only: addresses of other devices on your LAN (e.g. a phone at
# 192.168.1.20) allowed to load the dev server, comma-separated.
ALLOWED_DEV_ORIGINS=
