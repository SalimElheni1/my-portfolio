# Copy this file to .env.local (which is gitignored) and fill in real values.
# .env.local is never committed — it's how secrets stay out of the repo.

# Get a free API key at https://resend.com (free tier: 3,000 emails/month).
RESEND_API_KEY=

# Resend's unverified/sandbox mode only allows delivery to the exact email
# address your Resend account is signed up with — not just any inbox you
# own. Set this to that address. Once you buy a domain and verify it in
# Resend, you can remove this and it'll fall back to the public contact
# email in content/profile.ts.
CONTACT_TO_EMAIL=

# The site's public address, with no trailing slash (e.g. https://salimelhani.tn).
# Used for canonical links, the sitemap, robots.txt, and social previews.
# Pages are refreshed once a day while the site runs, so set it for the
# running server too, not only the build. A production build refuses to run
# without it; local dev falls back to http://localhost:3000.
SITE_URL=
